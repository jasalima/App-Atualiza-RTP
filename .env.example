# Server-only: nunca prefixar com NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.build/DB/auth
NEON_AUTH_COOKIE_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Endpoints públicos. A Data API só libera linhas autorizadas pelo JWT + RLS.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-xxx.neonauth.REGION.aws.neon.build/DB/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-xxx.apirest.REGION.aws.neon.build/DB/rest/v1

# Neon Object Storage (somente servidor)
NEON_STORAGE_BUCKET=rtp-private
AWS_ENDPOINT_URL_S3=https://storage.REGION.aws.neon.tech
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Motor de IA (somente servidor)
AI_PROVIDER=local
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Evolution API v2: endereço HTTPS confiável, somente no servidor.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_CREDENTIAL_SECRET=
